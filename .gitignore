# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# archives
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# local dev-server log (background `npm run dev *> .next-dev.log`)
.next-dev.log

# env files (can opt-in for committing if needed)
.env*
# ...but the committed template (no secrets) is tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code framework is TRACKED in git (.claude/CLAUDE.md + .claude/skills/).
# Only user-specific local files are ignored:
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local CC preview/QA screenshot artifacts (not source)
.preview-screenshots/
