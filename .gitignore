# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# archives
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# local dev-server log (background `npm run dev *> .next-dev.log`)
.next-dev.log

# env files (can opt-in for committing if needed)
.env*
# ...but the committed template (no secrets) is tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code framework is TRACKED in git (.claude/CLAUDE.md + .claude/skills/).
# Only user-specific local files are ignored:
.claude/settings.local.json
.claude/scheduled_tasks.lock

# local CC preview/QA screenshot artifacts (not source)
.preview-screenshots/

# Storybook static build (regenerated; never committed)
/storybook-static/

# VRT (scripts/vrt): headless-Chrome profiles + the throwaway current-run captures.
# __baselines__ is NOT ignored — it is the gate's reference set, committed by a HUMAN from the Linux
# images the CI job renders + uploads as an artifact (never pushed by CI; see docs/f2-state.md). A local
# `vrt:stories baseline` writes there for spot checks only; never commit locally-rendered baselines.
.vrt-chrome-profile/
.vrt-diff-profile/
.vrt-stories-profile/
/scripts/vrt/__current__/
/scripts/vrt/__to-commit__/

# Gate (scripts/gate): the authenticated runner's Chrome profile now lives in the OS temp dir, NOT
# here — Chrome auto-registers system extensions into a profile and their bundled *.spec.js files
# get collected by `vitest run`, which gitignoring does not prevent (vitest/eslint/tsc walk ignored
# dirs). This entry stays only to catch a stale directory from before that move; it also held a real
# minted session cookie, which must never be committed.
.gate-chrome-profile/
