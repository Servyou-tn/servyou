# Servyou — environment variables. Copy to .env.local and fill in.
# NEVER commit .env.local. Only the publishable (anon) Supabase key belongs in
# client-exposed (NEXT_PUBLIC_*) vars — never the service role key.

# ─── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key. NEVER expose this to the client (never NEXT_PUBLIC_*). Used only by
# src/lib/supabase/admin.ts, from inside 'use server' actions -- currently the sole writer of
# uploaded_objects, which denies INSERT to anon/authenticated by design. Also used by the RLS
# integration tests (src/__tests__/*-rls.test.ts) for fixture setup/teardown.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sentry error monitoring (Phase 10 safety net) ────────────────────────────
# Create a project at https://sentry.io and copy the DSN here. Without these vars
# Sentry no-ops gracefully and the app runs identically. See docs/operations.md.
# NEXT_PUBLIC_SENTRY_DSN activates capture; the SENTRY_* build vars enable source-map
# upload (only used at build time when SENTRY_AUTH_TOKEN is present).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
