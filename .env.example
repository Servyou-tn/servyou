# Servyou — environment variables. Copy to .env.local and fill in.
# NEVER commit .env.local. Only the publishable (anon) Supabase key belongs in
# client-exposed (NEXT_PUBLIC_*) vars — never the service role key.

# ─── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key. NEVER expose this to the client (never NEXT_PUBLIC_*). Used only by
# src/lib/supabase/admin.ts, from inside 'use server' actions -- currently the sole writer of
# uploaded_objects, which denies INSERT to anon/authenticated by design. Also used by the RLS
# integration tests (src/__tests__/*-rls.test.ts) for fixture setup/teardown.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare Turnstile (bot check) ─────────────────────────────────────────
# Invisible widget on sign-in, sign-up, order requests and reports (src/components/security/Turnstile.tsx);
# server-side siteverify in the order / report actions (src/lib/security/turnstile.ts).
# Both EMPTY → no widget, no verification (local dev, CI). Secret set → the actions FAIL CLOSED without a valid
# token, so set both together. Production / Preview: the real keys, on Vercel only (the site key is public;
# the secret is never NEXT_PUBLIC_*). Sign-in / sign-up are verified by Supabase Auth itself once CAPTCHA
# protection is enabled in the Supabase dashboard with the same secret.
# Local / tests: Cloudflare's official dummy keys (always pass, invisible) —
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# (the dummy secret only accepts the dummy token XXXX.DUMMY.TOKEN.XXXX that the dummy site key produces).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Sentry error monitoring (Phase 10 safety net) ────────────────────────────
# Create a project at https://sentry.io and copy the DSN here. Without these vars
# Sentry no-ops gracefully and the app runs identically. See docs/operations.md.
# NEXT_PUBLIC_SENTRY_DSN activates capture; the SENTRY_* build vars enable source-map
# upload (only used at build time when SENTRY_AUTH_TOKEN is present).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
